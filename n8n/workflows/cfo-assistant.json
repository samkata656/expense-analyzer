        "query": "SELECT id, first_name, last_name\nFROM users\nWHERE lower(first_name) = lower(btrim($1))\n  AND lower(last_name) = lower(btrim($2))\n  AND employee_code = btrim($3)\n  AND role = 'cfo'\nLIMIT 1;",
