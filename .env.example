# Copy to .env (local) or paste into Portainer → Stack → Environment variables.
# Generate secrets with:  openssl rand -hex 32

# --- Postgres -------------------------------------------------------------
POSTGRES_PASSWORD=change-me-superuser
APP_DB_PASSWORD=change-me-app
CFO_DB_PASSWORD=change-me-cfo-readonly
N8N_DB_PASSWORD=change-me-n8n

# --- Web app --------------------------------------------------------------
# Public URL of the app (used for receipt image links stored in the DB)
PUBLIC_BASE_URL=https://expenses.samkobuilds.com
# Shared secret the web app sends to n8n webhooks in X-Webhook-Secret
N8N_WEBHOOK_SECRET=change-me-long-random-string

# --- n8n ------------------------------------------------------------------
N8N_HOST=n8n.samkobuilds.com
# Encryption key for stored credentials. NEVER change after first start.
N8N_ENCRYPTION_KEY=change-me-long-random-string
GENERIC_TIMEZONE=Europe/Sofia

# --- Images (GHCR) --------------------------------------------------------
GHCR_OWNER=samkata656
IMAGE_TAG=latest
